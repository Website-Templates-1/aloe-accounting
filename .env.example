# ---------------------------------------------------------------------------
# ALOE Accounting and Tax — environment
# Copy to .env.local for development. NONE of these are required to build/run;
# the contact form falls back to a safe console adapter until configured.
# ---------------------------------------------------------------------------

# Email delivery (contact/quote form). Not wired to a live provider yet.
#   EMAIL_PROVIDER: "console" (default, logs only) | "resend"
EMAIL_PROVIDER=console
# RESEND_API_KEY=            # required only when EMAIL_PROVIDER=resend
# CONTACT_INBOX=info@aloecpa.com          # where submissions are delivered
# CONTACT_SENDER=website@aloeaccountingandtax.com  # verified sending identity

# Google reviews (Google Business Profile via Places API "New").
# When set, live reviews replace the static fallback. Enable the
# "Places API (New)" on this key and restrict it to your domain/server.
# GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Admin panel + AI blog approval (see docs / plan)
# ---------------------------------------------------------------------------

# Signs the admin session cookie. REQUIRED for the admin panel.
#   openssl rand -base64 32
# AUTH_SECRET=

# Owner login. Password is stored as a scrypt hash "saltHex:hashHex", never plaintext.
# This is the bootstrap login. After signing in, the owner sets their own
# password at /admin/account — that overlay replaces these env credentials.
# Generate the hash (replace 'your-password'):
#   node -e "const c=require('crypto');const s=c.randomBytes(16);process.stdout.write(s.toString('hex')+':'+c.scryptSync('your-password',s,64).toString('hex'))"
# OWNER_USERNAME=owner
# OWNER_PASSWORD_HASH=

# GitHub content store (the "database"). When set, the admin reads/writes the
# live repo; unset = local filesystem fallback (dev). Fine-grained PAT scoped to
# this one repo with Contents: Read and write.
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_BRANCH=main

# Shared secret for the scheduled generation trigger (Bearer token).
#   openssl rand -base64 32
# CRON_SECRET=

# OpenAI (blog draft generation).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Central Review Management API (server-only; NEVER expose to the browser).
# ---------------------------------------------------------------------------
# This portal is one client of a shared, multi-tenant review service. The
# browser NEVER calls the central API directly — it talks only to our own
# guarded /api/admin/reviews/* route handlers, which read these on the server.
# Do NOT prefix with NEXT_PUBLIC_ and never return the key to a client bundle.
# Unset is safe: the reviews pages are force-dynamic and env is read lazily.
# REVIEW_API_URL=      # base URL of the central service (no trailing slash)
# REVIEW_API_KEY=      # this client's per-project bearer key (esk_...), scoped to one project
